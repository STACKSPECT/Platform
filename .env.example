# Copia esto a .env (gitignorado) con los valores de tu proyecto de Supabase.
# Project Settings -> Data API -> Project URL, y API Keys.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Pública: lectura bajo RLS. Es la que acaba en el navegador.
SUPABASE_ANON_KEY=eyJ...

# SECRETA: se salta RLS. Solo el lado Python (SDK, backfill, seed). Nunca en el front.
SUPABASE_SERVICE_KEY=eyJ...
