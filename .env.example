# Copia esto a .env (gitignorado) con los valores de tu proyecto de Supabase.
#
# Es el UNICO fichero de credenciales del repo: lo lee load_env() del lado Python
# y, a traves de frontend/next.config.ts, tambien el front. No hay .env.local.
# Project Settings -> Data API -> Project URL, y API Keys.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Pública: lectura bajo RLS. Es la que acaba en el navegador, publicada por
# next.config.ts como NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=eyJ...

# SECRETA: se salta RLS. Solo el lado Python (SDK, backfill, seed). Nunca en el front.
SUPABASE_SERVICE_KEY=eyJ...
